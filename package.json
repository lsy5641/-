{
  "name": "jobcoach",
  "version": "1.0.1",
  "private": true,
  "description": "JobCoach 求职助手：终身履历 + JD 定制简历 + AI 教练 + 备考中心",
  "author": "JobCoach",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server/src/dev.ts",
    "start": "tsx server/src/index.ts",
    "build": "vite build",
    "build:server": "esbuild server/src/start.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server/start.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "npm run build && npm run build:server && electron .",
    "dist:win": "npm run build && npm run build:server && electron-builder --win portable nsis"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.jobcoach.app",
    "productName": "JobCoach",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "JobCoach-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JobCoach",
      "artifactName": "JobCoach-Setup-${version}.exe"
    }
  }
}